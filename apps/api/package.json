{
  "name": "@trustpass/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify-credential": "tsx src/scripts/verify-credential.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@trustpass/db": "workspace:*",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  }
}
