{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/route-read.mjs"],
            "timeout": 30,
            "statusMessage": "Routing read"
          }
        ]
      }
    ]
  }
}
