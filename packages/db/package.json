{
  "name": "@trustpass/db",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./identity": "./src/identity/trustpass-id.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision": "tsx src/scripts/provision-roles.ts",
    "db:backup": "tsx src/scripts/backup.ts",
    "db:restore-drill": "tsx src/scripts/restore-drill.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:preflight": "tsx src/scripts/issuer-preflight.ts",
    "db:issue-credential": "tsx src/scripts/issue-credential.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
