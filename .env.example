# ---------------------------------------------------------------------------
# TrustPass - local development environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Postgres (docker compose).
# 5433 by default so the container does not collide with a Postgres instance
# already listening on the conventional 5432.
POSTGRES_USER=trustpass
POSTGRES_PASSWORD=trustpass_local_dev
POSTGRES_DB=trustpass
POSTGRES_PORT=5433

# Connection string consumed by the API and by drizzle-kit
DATABASE_URL=postgresql://trustpass:trustpass_local_dev@localhost:5433/trustpass

# API
API_PORT=3001
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
